{
  "kind": "CallWidget",
  "major": 1,
  "title": "Call Widget",
  "category": "Events",
  "milestone": "0.4",
  "pure": false,
  "inputs": [
    {
      "name": "in",
      "type": "Exec"
    }
  ],
  "outputs": [
    {
      "name": "then",
      "type": "Exec"
    }
  ],
  "fields": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "default": "Show",
      "description": "Name of the On Widget Call node of this graph to run"
    },
    "params": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "String",
              "Number",
              "Bool"
            ]
          }
        }
      }
    }
  },
  "as2Template": "templates/CallWidget.as2",
  "extra": {
    "dynamicInputs": "params"
  }
}
