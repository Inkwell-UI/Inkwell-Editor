"// Generated by Inkwell from the graph "m" (m). Do not edit.
// AS2 sealing is a compile-time check only and the FFDec AS2 compiler does not parse the keyword \`dynamic\`; members are added freely (s_, t_, h_, v_).
class mods.M.TGraph_m {
    var base;
    var inputHandlers;
    var bridge;
    var messageHandlers;
    var modEventHandlers;
    function TGraph_m(base) {
        this.base = base;
        this.inputHandlers = {};
        this.messageHandlers = [];
        this.modEventHandlers = [];
    }
    // logs the failing node id; e is a string or a plain object {node, message} (GFx has no Error class)
    function fail(nodeId, e) {
        var msg = "";
        if (typeof (e) == "object") {
            if (e.node != undefined) nodeId = e.node;
            msg = e.message != undefined ? String(e.message) : String(e);
        } else {
            msg = String(e);
        }
        this.log("error", nodeId, msg);
    }
    function log(level, nodeId, text) {
        if (this.bridge.ready == true) {
            this.bridge.log(level, nodeId, String(text));
        } else {
            trace("[Inkwell] " + level + " " + nodeId + ": " + text);
        }
    }
    // glue: the menu class (docs/menus.md) calls handleInput / handleMessage / handleModEvent; the runtime forwards the engine events to it
    function addInputHandler(action, fn) {
        if (this.inputHandlers[action] == undefined) this.inputHandlers[action] = [];
        this.inputHandlers[action].push(fn);
    }
    function handleInput(action) {
        var list = this.inputHandlers[action];
        for (var k = 0; k < list.length; k++) list[k]();
    }
    // On Runtime Message (S7): name = Inkwell_API.Set* key; a handler registered under "" takes any name
    function addMessageHandler(name, fn) {
        this.messageHandlers.push({ name: name, fn: fn });
    }
    function handleMessage(name, text, number, flag) {
        for (var k = 0; k < this.messageHandlers.length; k++) {
            var h = this.messageHandlers[k];
            if (h.name == "" || h.name == name) h.fn(name, text, number, flag);
        }
    }
    // On Mod Event (S7): fires only while the menu is open (the runtime drops events while it is closed)
    function addModEventHandler(name, fn) {
        this.modEventHandlers.push({ name: name, fn: fn });
    }
    function handleModEvent(name, strArg, numArg) {
        for (var k = 0; k < this.modEventHandlers.length; k++) {
            var h = this.modEventHandlers[k];
            if (h.name == name) h.fn(strArg, numArg);
        }
    }
    function init() {
        var __g = this;
        __g.v_count = __g.bridge.getSaved("count", 0);
        if (typeof (__g.v_count) != "number" || isNaN(__g.v_count)) {
            __g.log("warn", "", "saved variable count: the stored value is not a Number, using the default");
            __g.v_count = 0;
        }
        // [e] core/OnOpen@1
        __g.onOpen = function() {
            try {
                // [s] core/SetVariable@1
                __g.v_count = 0;
                __g.bridge.setSaved("count", __g.v_count);
                // [t] core/Toggle@1
                __g.v_count = !(__g.v_count == true);
                var t_value = __g.v_count == true;
                __g.bridge.setSaved("count", __g.v_count);
                // [l] core/Log@1
                __g.log("info", "l", "");
            } catch (e) {
                __g.fail("e", e);
            }
        };
    }
}
"
