exports[`dev flavour of the menu class > dumpVariables asks every graph, each guarded (golden); the normal flavour keeps the empty method 1`] = `
"// Generated by Inkwell: the menu glue (SPEC-CHANGES S7). The Inkwell Runtime calls start/onOpen/onClose/onInput/onMessage/onModEvent/dumpVariables through _root.inkwellMenu. Do not edit.
class mods.MyMod.WheelMenu {
    var base;
    var bridge;
    var graphs;
    var timer;
    var polls;
    function WheelMenu(base) {
        this.base = base;
        this.graphs = [];
        this.polls = 0;
    }
    // S4.2 retry rule: the runtime installs _root.inkwell right after the movie loads and sets ready last. Poll every 50 ms, up to 100 times, then run with a stub.
    function start() {
        var self = this;
        if (_root.inkwell.ready == true) {
            this.begin(_root.inkwell);
            return;
        }
        this.timer = setInterval(function() {
            self.polls++;
            if (_root.inkwell.ready == true) {
                clearInterval(self.timer);
                self.begin(_root.inkwell);
            } else if (self.polls >= 100) {
                clearInterval(self.timer);
                trace("[Inkwell] inkwell bridge missing");
                self.begin(self.stub());
            }
        }, 50);
    }
    function stub() {
        var noop = function() {};
        return { ready: false, version: 0, menu: "", uiScale: 1, offsetX: 0, offsetY: 0, theme: "", log: noop, glueReady: noop, openMenu: function() { return false; }, closeMenu: function() { return false; }, sendModEvent: noop, callRuntime: function() { return ""; }, playSound: function() { return false; }, getSetting: function(section, key, defaultValue) { return defaultValue; }, getInputDevice: function() { return "keyboardMouse"; }, getSaved: function(name, defaultValue) { return defaultValue; }, setSaved: noop, watch: noop, pin: noop };
    }
    function begin(bridge) {
        this.bridge = bridge;
        // UI scale and offset from the INI (S9): the 1920x1080 reference stage; untouched at the defaults
        var s = Number(bridge.uiScale);
        if (!(s > 0)) s = 1;
        var ox = Number(bridge.offsetX) || 0;
        var oy = Number(bridge.offsetY) || 0;
        if (s != 1 || ox != 0 || oy != 0) {
            _root._xscale = 100 * s;
            _root._yscale = 100 * s;
            _root._x = 960 * (1 - s) + ox;
            _root._y = 540 * (1 - s) + oy;
        }
        var g;
        g = new mods.MyMod.WheelGraph_main(this.base);
        g.bridge = bridge;
        this.base.inkwellGraph0 = g;
        this.graphs.push(g);
        try {
            g.init();
        } catch (e) {
            g.fail("main", e);
        }
        bridge.glueReady();
    }
    function onOpen() {
        for (var k = 0; k < this.graphs.length; k++) {
            var g = this.graphs[k];
            if (g.onOpen != undefined) g.onOpen();
        }
    }
    function onClose() {
        for (var k = 0; k < this.graphs.length; k++) {
            var g = this.graphs[k];
            if (g.onClose != undefined) g.onClose();
        }
    }
    function onInput(action) {
        for (var k = 0; k < this.graphs.length; k++) this.graphs[k].handleInput(action);
    }
    function onMessage(name, text, number, flag) {
        for (var k = 0; k < this.graphs.length; k++) this.graphs[k].handleMessage(name, text, number, flag);
    }
    function onModEvent(name, strArg, numArg) {
        for (var k = 0; k < this.graphs.length; k++) this.graphs[k].handleModEvent(name, strArg, numArg);
    }
    // dev build (S6): the runtime asks for a full dump when the editor subscribes to the watch
    function dumpVariables() {
        for (var k = 0; k < this.graphs.length; k++) {
            try {
                this.graphs[k].dumpVariables();
            } catch (e) {
            }
        }
    }
}
"
`;
