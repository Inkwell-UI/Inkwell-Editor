        _root.inkwellContract.on("InvalidateListData", function() {
            var OnInvalidateList_items = _root.inkwellContract.list.entryList;
            if (!(OnInvalidateList_items instanceof Array)) OnInvalidateList_items = [];
            var OnInvalidateList_count = OnInvalidateList_items.length;
