                trace("[Inkwell] info log_OnPlayerInfo: " + "OnPlayerInfo");
            } catch (e) {
                __g.fail("OnPlayerInfo", e);
            }
        });
        // [OnRestoreIndices] core/InventoryOnRestoreIndices@1
        _root.inkwellContract.on("RestoreIndices", function() {
            var OnRestoreIndices_indices = [];
            for (var k = 0; k < arguments.length; k++) OnRestoreIndices_indices.push(arguments[k]);
            try {
                // [log_OnRestoreIndices] core/Log@1
                trace("[Inkwell] info log_OnRestoreIndices: " + "OnRestoreIndices");
            } catch (e) {
