    function fail(nodeId, e) {
        var msg = "";
        if (typeof (e) == "object") {
            if (e.node != undefined) nodeId = e.node;
            msg = e.message != undefined ? String(e.message) : String(e);
        } else {
            msg = String(e);
        }
        var line = "[Inkwell] error " + nodeId + ": " + msg;
        trace(line);
        try {
            if (typeof (_global.skse) == "object" && _global.skse.Log != undefined) _global.skse.Log(line);
        } catch (x) {
        }
    }
    // On Input glue: the host calls handleInput("<action>"); 0.2 has no input source yet (the runtime comes in 0.3)
    function addInputHandler(action, fn) {
        if (this.inputHandlers[action] == undefined) this.inputHandlers[action] = [];
        this.inputHandlers[action].push(fn);
    }
    function handleInput(action) {
        var list = this.inputHandlers[action];
        for (var k = 0; k < list.length; k++) list[k]();
    }
    function init() {
        var __g = this;
        // [OnSetCategories] core/InventoryOnSetCategories@1
        _root.inkwellContract.on("SetCategoriesList", function() {
            var OnSetCategories_categories = [];
            for (var k = 0; k + 2 < arguments.length; k += 3) OnSetCategories_categories.push({ text: String(arguments[k]), flag: Number(arguments[k + 1]) || 0, dontHide: arguments[k + 2] == true });
            try {
