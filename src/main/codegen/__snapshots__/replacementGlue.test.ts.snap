exports[`replacement glue from the InventoryMenu contract > golden AS2, engine + SkyUI 5.2 1`] = `
"// Generated by Inkwell: the engine glue of a menu replacement (contract "InventoryMenu", layers engine, skyui52; SPEC-CHANGES W5). Do not edit.
class mods.MyMod.InvContract {
    var base;
    var list;
    var handlers;
    var pending;
    var nextId;
    function InvContract(base) {
        this.base = base;
        this.handlers = {};
        this.pending = {};
        this.nextId = 0;
    }
    function install() {
        var self = this;
        // the object _root.GetInventoryItemList() returns: the engine fills its members and reads them (S-B: entryList filled, selectedIndex read for the item it acts on)
        this.list = this.base.createEmptyMovieClip("inkwellList", this.base.getNextHighestDepth());
        this.list.entryList = [];
        this.list.selectedIndex = 0;
        // the other list members of the spike baseline; the engine never used them in S-B
        this.list.scrollPosition = 0;
        this.list.addProperty("selectedEntry", function() { return this.entryList[this.selectedIndex]; }, null);
        this.list.addProperty("length", function() { return this.entryList.length; }, null);
        this.list.InvalidateData = function() {};
        this.list.UpdateList = function() {};
        this.base.GetInventoryItemList = function() { return self.list; };
        this.base.InitExtensions = function() { self.fire("InitExtensions", self.args(arguments, 0)); };
        this.base.SetPlatform = function() { self.fire("SetPlatform", self.args(arguments, 0)); };
        // engine -> AS through ExternalInterface, as gfx.io.GameDelegate registers it (S-B A5: without it no callback arrives)
        flash.external.ExternalInterface.addCallback("call", this.base, function(name) { self.fire(String(name), self.args(arguments, 1)); });
        flash.external.ExternalInterface.addCallback("respond", this.base, function(uid) { self.answer(uid, self.args(arguments, 1)); });
        _global.InventoryMenu = function() {};
        _global.InventoryMenu.SKYUI_RELEASE_IDX = 2018;
        _global.InventoryMenu.SKYUI_VERSION_STRING = "5.2 SE";
        _global.ItemCard = function() {};
        _global.ItemCard.SKYUI_RELEASE_IDX = 2018;
        _global.ItemCard.SKYUI_VERSION_STRING = "5.2 SE";
        _global.BottomBar = function() {};
        _global.BottomBar.SKYUI_RELEASE_IDX = 2018;
        _global.BottomBar.SKYUI_VERSION_STRING = "5.2 SE";
        _global.InventoryLists = function() {};
        _global.InventoryLists.SKYUI_RELEASE_IDX = 2018;
        _global.InventoryLists.SKYUI_VERSION_STRING = "5.2 SE";
    }
    function args(a, from) {
        var r = [];
        for (var k = from; k < a.length; k++) r.push(a[k]);
        return r;
    }
    // contract nodes: an engine callback (or a respond answer) runs every handler registered under its name
    function on(name, fn) {
        if (this.handlers[name] == undefined) this.handlers[name] = [];
        this.handlers[name].push(fn);
    }
    function fire(name, a) {
        var list = this.handlers[name];
        if (list == undefined) return;
        for (var k = 0; k < list.length; k++) {
            try {
                list[k].apply(null, a);
            } catch (e) {
                trace("[Inkwell] error " + name + ": " + e);
            }
        }
    }
    // AS -> engine in the GameDelegate wire format: call(name, uid, ...args); the engine answers a request through respond(uid, ...) during the call
    function send(name, a, respondTo) {
        var id = this.nextId++;
        if (respondTo != undefined) this.pending[id] = respondTo;
        var p = [name, id];
        for (var k = 0; k < a.length; k++) p.push(a[k]);
        flash.external.ExternalInterface.call.apply(null, p);
        delete this.pending[id];
    }
    function answer(uid, a) {
        var to = this.pending[uid];
        delete this.pending[uid];
        if (to != undefined) this.fire(to, a);
    }
    // the engine acts on the list's selectedIndex (S-B A6); -1 keeps the current one
    function select(index) {
        if (index >= 0) this.list.selectedIndex = index;
    }
}
"
`;
