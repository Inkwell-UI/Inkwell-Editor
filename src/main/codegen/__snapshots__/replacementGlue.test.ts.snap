                trace("[Inkwell] info log_OnInvalidateList: " + String(OnInvalidateList_count));
            } catch (e) {
                __g.fail("OnInvalidateList", e);
            }
        });
        // [OnPlayerInfo] core/InventoryOnPlayerInfo@1
        _root.inkwellContract.on("UpdatePlayerInfo", function() {
