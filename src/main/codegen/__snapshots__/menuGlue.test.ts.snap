exports[`menu class > golden AS2 for two graphs and a focusable button 1`] = `
"// Generated by Inkwell: the menu glue (SPEC-CHANGES S7). The Inkwell Runtime calls start/onOpen/onClose/onInput/onMessage/onModEvent/dumpVariables through _root.inkwellMenu. Do not edit.
class mods.MyMod.WheelMenu {
    var base;
    var bridge;
    var graphs;
    var timer;
    var polls;
    function WheelMenu(base) {
        this.base = base;
        this.graphs = [];
        this.polls = 0;
    }
    // S4.2 retry rule: the runtime installs _root.inkwell right after the movie loads and sets ready last. Poll every 50 ms, up to 100 times, then run with a stub.
    function start() {
        var self = this;
        if (_root.inkwell.ready == true) {
            this.begin(_root.inkwell);
            return;
        }
        this.timer = setInterval(function() {
            self.polls++;
            if (_root.inkwell.ready == true) {
                clearInterval(self.timer);
                self.begin(_root.inkwell);
            } else if (self.polls >= 100) {
                clearInterval(self.timer);
                trace("[Inkwell] inkwell bridge missing");
                self.begin(self.stub());
            }
        }, 50);
    }
    function stub() {
        var noop = function() {};
        return { ready: false, version: 0, menu: "", uiScale: 1, offsetX: 0, offsetY: 0, theme: "", log: noop, glueReady: noop, openMenu: function() { return false; }, closeMenu: function() { return false; }, sendModEvent: noop, callRuntime: function() { return ""; }, playSound: function() { return false; }, getSetting: function(section, key, defaultValue) { return defaultValue; }, getInputDevice: function() { return "keyboardMouse"; }, getSaved: function(name, defaultValue) { return defaultValue; }, setSaved: noop, watch: noop, pin: noop };
    }
    function begin(bridge) {
        this.bridge = bridge;
        // UI scale and offset from the INI (S9): the 1920x1080 reference stage; untouched at the defaults
        var s = Number(bridge.uiScale);
        if (!(s > 0)) s = 1;
        var ox = Number(bridge.offsetX) || 0;
        var oy = Number(bridge.offsetY) || 0;
        if (s != 1 || ox != 0 || oy != 0) {
            _root._xscale = 100 * s;
            _root._yscale = 100 * s;
            _root._x = 960 * (1 - s) + ox;
            _root._y = 540 * (1 - s) + oy;
        }
        try {
            this.base.btn.tabEnabled = true;
            this.base.rows.tabEnabled = true;
        } catch (e) {
        }
        var g;
        g = new mods.MyMod.WheelGraph_main(this.base);
        g.bridge = bridge;
        this.base.inkwellGraph0 = g;
        this.graphs.push(g);
        try {
            g.init();
        } catch (e) {
            g.fail("main", e);
        }
        g = new mods.MyMod.WheelGraph_list(this.base);
        g.bridge = bridge;
        this.base.inkwellGraph1 = g;
        this.graphs.push(g);
        try {
            g.init();
        } catch (e) {
            g.fail("list", e);
        }
        bridge.glueReady();
    }
    function onOpen() {
        for (var k = 0; k < this.graphs.length; k++) {
            var g = this.graphs[k];
            if (g.onOpen != undefined) g.onOpen();
        }
    }
    function onClose() {
        for (var k = 0; k < this.graphs.length; k++) {
            var g = this.graphs[k];
            if (g.onClose != undefined) g.onClose();
        }
    }
    function onInput(action) {
        for (var k = 0; k < this.graphs.length; k++) this.graphs[k].handleInput(action);
    }
    function onMessage(name, text, number, flag) {
        for (var k = 0; k < this.graphs.length; k++) this.graphs[k].handleMessage(name, text, number, flag);
    }
    function onModEvent(name, strArg, numArg) {
        for (var k = 0; k < this.graphs.length; k++) this.graphs[k].handleModEvent(name, strArg, numArg);
    }
    // dev builds report every variable through bridge.watch (S6, Phase 6); nothing to report yet
    function dumpVariables() {
    }
}
"
`;

exports[`menu-flavoured graph class > rewrites the Log trace to the bridge, fail goes through log, and the message/mod event registries exist 1`] = `
"// Generated by Inkwell from the graph "Main" (main). Do not edit.
// AS2 sealing is a compile-time check only and the FFDec AS2 compiler does not parse the keyword \`dynamic\`; members are added freely (s_, t_, h_, v_).
class mods.InkwellMenuTest.MenuGraph_main {
    var base;
    var inputHandlers;
    var bridge;
    var messageHandlers;
    var modEventHandlers;
    function MenuGraph_main(base) {
        this.base = base;
        this.inputHandlers = {};
        this.messageHandlers = [];
        this.modEventHandlers = [];
    }
    // logs the failing node id; e is a string or a plain object {node, message} (GFx has no Error class)
    function fail(nodeId, e) {
        var msg = "";
        if (typeof (e) == "object") {
            if (e.node != undefined) nodeId = e.node;
            msg = e.message != undefined ? String(e.message) : String(e);
        } else {
            msg = String(e);
        }
        this.log("error", nodeId, msg);
    }
    function log(level, nodeId, text) {
        if (this.bridge.ready == true) {
            this.bridge.log(level, nodeId, String(text));
        } else {
            trace("[Inkwell] " + level + " " + nodeId + ": " + text);
        }
    }
    // glue: the menu class (docs/menus.md) calls handleInput / handleMessage / handleModEvent; the runtime forwards the engine events to it
    function addInputHandler(action, fn) {
        if (this.inputHandlers[action] == undefined) this.inputHandlers[action] = [];
        this.inputHandlers[action].push(fn);
    }
    function handleInput(action) {
        var list = this.inputHandlers[action];
        for (var k = 0; k < list.length; k++) list[k]();
    }
    // On Runtime Message (S7): name = Inkwell_API.Set* key; a handler registered under "" takes any name
    function addMessageHandler(name, fn) {
        this.messageHandlers.push({ name: name, fn: fn });
    }
    function handleMessage(name, text, number, flag) {
        for (var k = 0; k < this.messageHandlers.length; k++) {
            var h = this.messageHandlers[k];
            if (h.name == "" || h.name == name) h.fn(name, text, number, flag);
        }
    }
    // On Mod Event (S7): fires only while the menu is open (the runtime drops events while it is closed)
    function addModEventHandler(name, fn) {
        this.modEventHandlers.push({ name: name, fn: fn });
    }
    function handleModEvent(name, strArg, numArg) {
        for (var k = 0; k < this.modEventHandlers.length; k++) {
            var h = this.modEventHandlers[k];
            if (h.name == name) h.fn(strArg, numArg);
        }
    }
    function init() {
        var __g = this;
        // [click] core/OnClick@1
        __g.base.btn.onRelease = function() {
            try {
                // [settext] core/SetText@1
                __g.base.status.text = "Button clicked!";
                // [log] core/Log@1
                __g.log("info", "log", "button clicked");
            } catch (e) {
                __g.fail("click", e);
            }
        };
    }
}
"
`;
