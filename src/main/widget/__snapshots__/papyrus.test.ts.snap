exports[`generated Papyrus > popup: typed SetTexts/Show/Hide, a console Test helper, calls remembered until ready (snapshot) 1`] = `
"Scriptname WidgetMod_Hud extends SKI_WidgetBase
{generated by Inkwell - do not edit; regenerate from the Inkwell project}

; ---- generated by Inkwell: HUD widget "Popup" ----

Event OnWidgetInit()
	WidgetName = "Popup"
	HAnchor = "right"
	VAnchor = "top"
	Debug.Trace("[Inkwell] WidgetMod_Hud OnWidgetInit")
EndEvent

; relative to Interface/exported/widgets/
string Function GetWidgetSource()
	return "WidgetMod/Hud.swf"
EndFunction

; must be this base script's name; the quest carries WidgetMod_HudInstance
string Function GetWidgetType()
	return "WidgetMod_Hud"
EndFunction

; position is the anchor point in SkyUI HUD space (1280x720), alpha in percent
Event OnWidgetReset()
	Parent.OnWidgetReset()
	X = 1253.333
	Y = 26.667
	Alpha = 100.0
	Debug.Trace("[Inkwell] WidgetMod_Hud OnWidgetReset at " + X + "," + Y)
	If _hasTexts
		UI.InvokeStringA("HUD Menu", WidgetRoot + ".setTexts", _texts)
	EndIf
	If _pendingShow
		_pendingShow = False
		UI.InvokeFloat("HUD Menu", WidgetRoot + ".show", _pendingHold)
	EndIf
EndEvent

; ---- popup API: settable texts (overlay role "text"), in layer order ----
;   asTitle: layer "$NAME" (node 44:5)
;   asDescription: layer "$DESC" (node 44:6)
; Safe before the widget is ready: the call is remembered and applied in OnWidgetReset.

String[] _texts
Bool _hasTexts = False
Bool _pendingShow = False
Float _pendingHold = 4.0

; sets the texts without changing visibility
Function SetTexts(String asTitle, String asDescription)
	_texts = new String[2]
	_texts[0] = asTitle
	_texts[1] = asDescription
	_hasTexts = True
	If Ready
		UI.InvokeStringA("HUD Menu", WidgetRoot + ".setTexts", _texts)
	EndIf
EndFunction

; sets the texts, fades in (0.3 s), holds afHoldSeconds, fades out; afHoldSeconds <= 0 stays until Hide(). A Show while visible restarts the hold.
Function Show(String asTitle, String asDescription, Float afHoldSeconds = 4.0)
	SetTexts(asTitle, asDescription)
	If Ready
		UI.InvokeFloat("HUD Menu", WidgetRoot + ".show", afHoldSeconds)
	Else
		_pendingShow = True
		_pendingHold = afHoldSeconds
	EndIf
EndFunction

; fades out from the current alpha
Function Hide()
	_pendingShow = False
	If Ready
		UI.InvokeFloat("HUD Menu", WidgetRoot + ".hide", 0.0)
	EndIf
EndFunction

; test helper, from the console: cgf "WidgetMod_Hud.Test"
Function Test() global
	; 2048 = local form id 0x800 of the quest in the ESL-flagged plugin
	WidgetMod_Hud w = Game.GetFormFromFile(2048, "WidgetMod.esp") as WidgetMod_Hud
	If w
		Debug.Trace("[Inkwell] WidgetMod_Hud.Test: Show")
		w.Show("Inkwell test", "Text 2, shown by WidgetMod_Hud.Test from the console", 4.0)
	Else
		Debug.Trace("[Inkwell] WidgetMod_Hud.Test: quest not found in WidgetMod.esp")
	EndIf
EndFunction
"
`;

