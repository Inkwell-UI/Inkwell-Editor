// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`samples/hud-graph-popup > Papyrus: Show(String, String, Float), Hide(), Nodes(Bool); calls before Ready are remembered and replayed; hotkey and Test() call Show with a 4 s hold 1`] = `
"Scriptname InkwellGraphPopup_Hud extends SKI_WidgetBase
{generated by Inkwell - do not edit; regenerate from the Inkwell project}

; ---- generated by Inkwell: HUD widget "Popup" ----

Event OnWidgetInit()
	WidgetName = "Popup"
	HAnchor = "right"
	VAnchor = "top"
	Debug.Trace("[Inkwell] InkwellGraphPopup_Hud OnWidgetInit")
EndEvent

; relative to Interface/exported/widgets/
string Function GetWidgetSource()
	return "InkwellGraphPopup/Hud.swf"
EndFunction

; must be this base script's name; the quest carries InkwellGraphPopup_HudInstance
string Function GetWidgetType()
	return "InkwellGraphPopup_Hud"
EndFunction

; position is the anchor point in SkyUI HUD space (1280x720), alpha in percent
Event OnWidgetReset()
	Parent.OnWidgetReset()
	X = 1253.333
	Y = 26.667
	Alpha = 100.0
	Debug.Trace("[Inkwell] InkwellGraphPopup_Hud OnWidgetReset at " + X + "," + Y)
	UnregisterForAllKeys()
	If DebugHotkey > 0
		RegisterForKey(DebugHotkey)
		Debug.Trace("[Inkwell] InkwellGraphPopup_Hud debug hotkey " + DebugHotkey)
	EndIf
	If _pendingCall != ""
		String c = _pendingCall
		_pendingCall = ""
		Debug.Trace("[Inkwell] InkwellGraphPopup_Hud replaying the call made before the widget was ready: " + c)
		If c == "Show"
			UI.InvokeStringA("HUD Menu", WidgetRoot + ".Show", _pendingArgs)
		ElseIf c == "Hide"
			UI.InvokeBool("HUD Menu", WidgetRoot + ".Hide", True)
		ElseIf c == "Nodes"
			UI.InvokeStringA("HUD Menu", WidgetRoot + ".Nodes", _pendingArgs)
		EndIf
	EndIf
EndEvent

; ---- widget API: the On Widget Call entries of the project's graphs ----
; Int Property DebugHotkey: a DirectInput scan code (65 = F7), 0 = off. Set per project in the Inkwell overlay (debugHotkey); keep 0 for a release.
Int Property DebugHotkey = 65 Auto

; the last call made before the widget was ready, replayed once in OnWidgetReset
String _pendingCall = ""
String[] _pendingArgs

; generated from the graph's On Widget Call "Show"
Function Show(String asTitle, String asDescription, Float afHold)
	String[] a = new String[3]
	a[0] = asTitle
	a[1] = asDescription
	a[2] = afHold as String
	If Ready
		UI.InvokeStringA("HUD Menu", WidgetRoot + ".Show", a)
	Else
		_pendingCall = "Show"
		_pendingArgs = a
		Debug.Trace("[Inkwell] InkwellGraphPopup_Hud.Show: the widget is not ready; remembered, replayed on reset")
	EndIf
EndFunction

; generated from the graph's On Widget Call "Hide"
Function Hide()
	If Ready
		UI.InvokeBool("HUD Menu", WidgetRoot + ".Hide", True)
	Else
		_pendingCall = "Hide"
		Debug.Trace("[Inkwell] InkwellGraphPopup_Hud.Hide: the widget is not ready; remembered, replayed on reset")
	EndIf
EndFunction

; generated from the graph's On Widget Call "Nodes"
Function Nodes(Bool abFail)
	String[] a = new String[1]
	If abFail
		a[0] = "true"
	Else
		a[0] = "false"
	EndIf
	If Ready
		UI.InvokeStringA("HUD Menu", WidgetRoot + ".Nodes", a)
	Else
		_pendingCall = "Nodes"
		_pendingArgs = a
		Debug.Trace("[Inkwell] InkwellGraphPopup_Hud.Nodes: the widget is not ready; remembered, replayed on reset")
	EndIf
EndFunction

; each press of the debug hotkey runs the next step: Show('Inkwell test', 'Text 2, shown by the InkwellGraphPopup_Hud test', 4.0), Hide(), Nodes(False), Nodes(True), then again
Int _debugStep = 0

; SKSE key event; only while playing (not in the console or a menu)
Event OnKeyDown(Int aiKeyCode)
	If DebugHotkey > 0 && aiKeyCode == DebugHotkey && !Utility.IsInMenuMode()
		Int s = _debugStep
		_debugStep = (s + 1) % 4
		If s == 0
			Debug.Trace("[Inkwell] InkwellGraphPopup_Hud debug hotkey: Show('Inkwell test', 'Text 2, shown by the InkwellGraphPopup_Hud test', 4.0)")
			Show("Inkwell test", "Text 2, shown by the InkwellGraphPopup_Hud test", 4.0)
		ElseIf s == 1
			Debug.Trace("[Inkwell] InkwellGraphPopup_Hud debug hotkey: Hide()")
			Hide()
		ElseIf s == 2
			Debug.Trace("[Inkwell] InkwellGraphPopup_Hud debug hotkey: Nodes(False)")
			Nodes(False)
		ElseIf s == 3
			Debug.Trace("[Inkwell] InkwellGraphPopup_Hud debug hotkey: Nodes(True)")
			Nodes(True)
		EndIf
	EndIf
EndEvent

; test helper for other scripts: InkwellGraphPopup_Hud.Test()
Function Test() global
	; 2048 = local form id 0x800 of the quest in the ESL-flagged plugin
	InkwellGraphPopup_Hud w = Game.GetFormFromFile(2048, "InkwellGraphPopup.esp") as InkwellGraphPopup_Hud
	If w
		Debug.Trace("[Inkwell] InkwellGraphPopup_Hud.Test: Show")
		w.Show("Inkwell test", "Text 2, shown by the InkwellGraphPopup_Hud test", 4.0)
	Else
		Debug.Trace("[Inkwell] InkwellGraphPopup_Hud.Test: quest not found in InkwellGraphPopup.esp")
	EndIf
EndFunction
"
`;
