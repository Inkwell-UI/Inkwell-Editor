// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`samples/hud-graph > Papyrus: String, Number and Bool parameters and a function without parameters 1`] = `
"Scriptname M_Hud extends SKI_WidgetBase
{generated by Inkwell - do not edit; regenerate from the Inkwell project}

; ---- generated by Inkwell: HUD widget "x" ----

Event OnWidgetInit()
	WidgetName = "x"
	HAnchor = "right"
	VAnchor = "top"
	Debug.Trace("[Inkwell] M_Hud OnWidgetInit")
EndEvent

; relative to Interface/exported/widgets/
string Function GetWidgetSource()
	return "M/Hud.swf"
EndFunction

; must be this base script's name; the quest carries M_HudInstance
string Function GetWidgetType()
	return "M_Hud"
EndFunction

; position is the anchor point in SkyUI HUD space (1280x720), alpha in percent
Event OnWidgetReset()
	Parent.OnWidgetReset()
	X = 1253.333
	Y = 26.667
	Alpha = 100.0
	Debug.Trace("[Inkwell] M_Hud OnWidgetReset at " + X + "," + Y)
	UnregisterForAllKeys()
	If DebugHotkey > 0
		RegisterForKey(DebugHotkey)
		Debug.Trace("[Inkwell] M_Hud debug hotkey " + DebugHotkey)
	EndIf
	If _pendingCall != ""
		String c = _pendingCall
		_pendingCall = ""
		Debug.Trace("[Inkwell] M_Hud replaying the call made before the widget was ready: " + c)
		If c == "Popup"
			UI.InvokeStringA("HUD Menu", WidgetRoot + ".Popup", _pendingArgs)
		ElseIf c == "Hide"
			UI.InvokeBool("HUD Menu", WidgetRoot + ".Hide", True)
		EndIf
	EndIf
EndEvent

; ---- widget API: the On Widget Call entries of the project's graphs ----
; Int Property DebugHotkey: a DirectInput scan code (65 = F7), 0 = off. Set per project in the Inkwell overlay (debugHotkey); keep 0 for a release.
Int Property DebugHotkey = 0 Auto

; the last call made before the widget was ready, replayed once in OnWidgetReset
String _pendingCall = ""
String[] _pendingArgs

; generated from the graph's On Widget Call "Popup"
Function Popup(String asTitle, Float afHold, Bool abSticky)
	String[] a = new String[3]
	a[0] = asTitle
	a[1] = afHold as String
	If abSticky
		a[2] = "true"
	Else
		a[2] = "false"
	EndIf
	If Ready
		UI.InvokeStringA("HUD Menu", WidgetRoot + ".Popup", a)
	Else
		_pendingCall = "Popup"
		_pendingArgs = a
		Debug.Trace("[Inkwell] M_Hud.Popup: the widget is not ready; remembered, replayed on reset")
	EndIf
EndFunction

; generated from the graph's On Widget Call "Hide"
Function Hide()
	If Ready
		UI.InvokeBool("HUD Menu", WidgetRoot + ".Hide", True)
	Else
		_pendingCall = "Hide"
		Debug.Trace("[Inkwell] M_Hud.Hide: the widget is not ready; remembered, replayed on reset")
	EndIf
EndFunction

; each press of the debug hotkey runs the next step: Popup('Inkwell test', 4.0, False), Popup('Inkwell test', 4.0, True), Hide(), then again
Int _debugStep = 0

; SKSE key event; only while playing (not in the console or a menu)
Event OnKeyDown(Int aiKeyCode)
	If DebugHotkey > 0 && aiKeyCode == DebugHotkey && !Utility.IsInMenuMode()
		Int s = _debugStep
		_debugStep = (s + 1) % 3
		If s == 0
			Debug.Trace("[Inkwell] M_Hud debug hotkey: Popup('Inkwell test', 4.0, False)")
			Popup("Inkwell test", 4.0, False)
		ElseIf s == 1
			Debug.Trace("[Inkwell] M_Hud debug hotkey: Popup('Inkwell test', 4.0, True)")
			Popup("Inkwell test", 4.0, True)
		ElseIf s == 2
			Debug.Trace("[Inkwell] M_Hud debug hotkey: Hide()")
			Hide()
		EndIf
	EndIf
EndEvent

; test helper for other scripts: M_Hud.Test()
Function Test() global
	; 2048 = local form id 0x800 of the quest in the ESL-flagged plugin
	M_Hud w = Game.GetFormFromFile(2048, "M.esp") as M_Hud
	If w
		Debug.Trace("[Inkwell] M_Hud.Test: Popup")
		w.Popup("Inkwell test", 4.0, True)
	Else
		Debug.Trace("[Inkwell] M_Hud.Test: quest not found in M.esp")
	EndIf
EndFunction
"
`;

exports[`samples/hud-graph > Papyrus: one typed function per On Widget Call, the string-array transport, Test() and the hotkey kept 1`] = `
"Scriptname InkwellGraphTest_Hud extends SKI_WidgetBase
{generated by Inkwell - do not edit; regenerate from the Inkwell project}

; ---- generated by Inkwell: HUD widget "Graph" ----

Event OnWidgetInit()
	WidgetName = "Graph"
	HAnchor = "right"
	VAnchor = "top"
	Debug.Trace("[Inkwell] InkwellGraphTest_Hud OnWidgetInit")
EndEvent

; relative to Interface/exported/widgets/
string Function GetWidgetSource()
	return "InkwellGraphTest/Hud.swf"
EndFunction

; must be this base script's name; the quest carries InkwellGraphTest_HudInstance
string Function GetWidgetType()
	return "InkwellGraphTest_Hud"
EndFunction

; position is the anchor point in SkyUI HUD space (1280x720), alpha in percent
Event OnWidgetReset()
	Parent.OnWidgetReset()
	X = 1253.333
	Y = 26.667
	Alpha = 100.0
	Debug.Trace("[Inkwell] InkwellGraphTest_Hud OnWidgetReset at " + X + "," + Y)
	UnregisterForAllKeys()
	If DebugHotkey > 0
		RegisterForKey(DebugHotkey)
		Debug.Trace("[Inkwell] InkwellGraphTest_Hud debug hotkey " + DebugHotkey)
	EndIf
	If _pendingCall != ""
		String c = _pendingCall
		_pendingCall = ""
		Debug.Trace("[Inkwell] InkwellGraphTest_Hud replaying the call made before the widget was ready: " + c)
		If c == "Show"
			UI.InvokeStringA("HUD Menu", WidgetRoot + ".Show", _pendingArgs)
		EndIf
	EndIf
EndEvent

; ---- widget API: the On Widget Call entries of the project's graphs ----
; Int Property DebugHotkey: a DirectInput scan code (65 = F7), 0 = off. Set per project in the Inkwell overlay (debugHotkey); keep 0 for a release.
Int Property DebugHotkey = 65 Auto

; the last call made before the widget was ready, replayed once in OnWidgetReset
String _pendingCall = ""
String[] _pendingArgs

; generated from the graph's On Widget Call "Show"
Function Show(String asTitle)
	String[] a = new String[1]
	a[0] = asTitle
	If Ready
		UI.InvokeStringA("HUD Menu", WidgetRoot + ".Show", a)
	Else
		_pendingCall = "Show"
		_pendingArgs = a
		Debug.Trace("[Inkwell] InkwellGraphTest_Hud.Show: the widget is not ready; remembered, replayed on reset")
	EndIf
EndFunction

; SKSE key event; only while playing (not in the console or a menu)
Event OnKeyDown(Int aiKeyCode)
	If DebugHotkey > 0 && aiKeyCode == DebugHotkey && !Utility.IsInMenuMode()
		Debug.Trace("[Inkwell] InkwellGraphTest_Hud debug hotkey: Show")
		Show("Inkwell test")
	EndIf
EndEvent

; test helper for other scripts: InkwellGraphTest_Hud.Test()
Function Test() global
	; 2048 = local form id 0x800 of the quest in the ESL-flagged plugin
	InkwellGraphTest_Hud w = Game.GetFormFromFile(2048, "InkwellGraphTest.esp") as InkwellGraphTest_Hud
	If w
		Debug.Trace("[Inkwell] InkwellGraphTest_Hud.Test: Show")
		w.Show("Inkwell test")
	Else
		Debug.Trace("[Inkwell] InkwellGraphTest_Hud.Test: quest not found in InkwellGraphTest.esp")
	EndIf
EndFunction
"
`;
