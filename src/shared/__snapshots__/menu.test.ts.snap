exports[`default INI > is the Spec writer: commented keys, the author hotkey shown, a differing default uncommented, one section per menu 1`] = `
"; Inkwell Runtime settings for My Mod (MyMod). Remove the leading ; to change a setting.
; Deleting a line restores the default. Inkwell never overwrites this file after the first deploy.

[Menu.MyMod_Wheel]
; Key that opens the menu: DirectInput scan code (K is 37). 0 = no hotkey.
;OpenKey=37
; Menu size, 0.50 to 2.00.
UIScale=1.25
; Move the menu, in pixels of a 1920x1080 screen.
OffsetX=10
;OffsetY=0
; Theme name: a mode of the menu's Figma variable collection (for example Vanilla). Empty = the menu's default.
Theme=Dark

[Menu.MyMod_List]
; Key that opens the menu: DirectInput scan code (K is 37). 0 = no hotkey.
;OpenKey=0
; Menu size, 0.50 to 2.00.
;UIScale=1.00
; Move the menu, in pixels of a 1920x1080 screen.
;OffsetX=0
;OffsetY=0
; Theme name: a mode of the menu's Figma variable collection (for example Vanilla). Empty = the menu's default.
;Theme=
"
`;
