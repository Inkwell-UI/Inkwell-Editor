{
  "kind": "MakeObject",
  "major": 1,
  "title": "Make Object",
  "category": "Data",
  "milestone": "0.2",
  "pure": true,
  "inputs": [],
  "outputs": [
    {
      "name": "value",
      "type": "Object",
      "default": {}
    }
  ],
  "fields": {
    "pairs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 4,
      "description": "Number of key/value pairs (input pins key0, value0, key1, value1...)"
    },
    "valueType": {
      "type": "string",
      "enum": [
        "String",
        "Number",
        "Bool",
        "Array",
        "Object"
      ],
      "default": "String",
      "description": "Pin type of the untyped item or value (the Any-like convention: the output is coerced to this type)"
    }
  },
  "as2Template": "templates/MakeObject.as2",
  "extra": {
    "repeatInputs": {
      "count": "pairs",
      "pins": [
        {
          "name": "key",
          "type": "String",
          "default": ""
        },
        {
          "name": "value",
          "type": "String",
          "default": "",
          "typeFrom": "valueType"
        }
      ]
    }
  }
}
