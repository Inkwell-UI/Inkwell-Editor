{
  "kind": "Compare",
  "major": 1,
  "title": "Compare",
  "category": "Logic",
  "milestone": "0.2",
  "pure": true,
  "inputs": [
    {
      "name": "a",
      "type": "Number",
      "default": 0,
      "typeFrom": "valueType"
    },
    {
      "name": "b",
      "type": "Number",
      "default": 0,
      "typeFrom": "valueType"
    }
  ],
  "outputs": [
    {
      "name": "value",
      "type": "Bool",
      "default": false
    }
  ],
  "fields": {
    "valueType": {
      "type": "string",
      "enum": [
        "Number",
        "String",
        "Bool"
      ],
      "default": "Number"
    },
    "op": {
      "type": "string",
      "enum": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">="
      ],
      "default": "=="
    }
  },
  "as2Template": "templates/Compare.as2",
  "extra": {
    "inspector": {
      "description": "Compares two values and gives true or false.",
      "labels": {
        "valueType": "Compare as",
        "op": "Operator",
        "a": "First value",
        "b": "Second value"
      },
      "options": {
        "valueType": { "Number": "Numbers", "String": "Text", "Bool": "Yes / no" },
        "op": {
          "==": "is equal to (==)",
          "!=": "is not equal to (!=)",
          "<": "is less than (<)",
          "<=": "is at most (<=)",
          ">": "is greater than (>)",
          ">=": "is at least (>=)"
        }
      }
    }
  }
}
