{
  "kind": "Delay",
  "major": 1,
  "title": "Delay",
  "category": "Flow",
  "milestone": "0.2",
  "pure": false,
  "inputs": [
    {
      "name": "in",
      "type": "Exec"
    },
    {
      "name": "seconds",
      "type": "Number",
      "default": 1
    }
  ],
  "outputs": [
    {
      "name": "then",
      "type": "Exec"
    }
  ],
  "fields": {
    "name": {
      "type": "string",
      "default": "",
      "description": "Optional name, so Cancel Delay / Stop Timer can find this node (the node id is used when empty)"
    }
  },
  "as2Template": "templates/Delay.as2",
  "extra": {
    "timer": "seconds",
    "timerKey": "name"
  }
}
