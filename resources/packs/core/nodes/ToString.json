{
  "kind": "ToString",
  "major": 1,
  "title": "To String",
  "category": "Logic",
  "milestone": "0.2",
  "pure": true,
  "inputs": [
    {
      "name": "value",
      "type": "Number",
      "default": 0,
      "typeFrom": "valueType"
    }
  ],
  "outputs": [
    {
      "name": "value",
      "type": "String",
      "default": ""
    }
  ],
  "fields": {
    "valueType": {
      "type": "string",
      "enum": [
        "String",
        "Number",
        "Bool",
        "Array",
        "Object"
      ],
      "default": "Number",
      "description": "Pin type of the value to convert (Object for an item of For Each or Array Get). An object or array gives its contents, e.g. {name: \"Bob\", tags: [1, 2]}"
    }
  },
  "as2Template": "templates/ToString.as2"
}
