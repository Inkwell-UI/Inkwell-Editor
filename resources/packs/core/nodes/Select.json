    },
    {
      "name": "ifFalse",
      "type": "String",
      "default": "",
      "typeFrom": "valueType"
    }
  ],
  "outputs": [
    {
      "name": "value",
      "type": "String",
      "default": "",
      "typeFrom": "valueType"
    }
  ],
  "fields": {
    "valueType": {
      "type": "string",
      "enum": [
        "String",
        "Number",
        "Bool",
        "Array",
        "Object"
      ],
      "default": "String",
      "description": "Pin type of the untyped item or value (the Any-like convention: the output is coerced to this type)"
    }
  },
  "as2Template": "templates/Select.as2"
