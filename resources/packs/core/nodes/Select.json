{
  "kind": "Select",
  "major": 1,
  "title": "Select",
  "category": "Logic",
  "milestone": "0.2",
  "pure": true,
  "inputs": [
    {
      "name": "condition",
      "type": "Bool",
      "default": false
    },
    {
      "name": "ifTrue",
      "type": "String",
      "default": "",
