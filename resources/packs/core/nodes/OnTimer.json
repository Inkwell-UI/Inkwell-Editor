{
  "kind": "OnTimer",
  "major": 1,
  "title": "On Timer",
  "category": "Events",
  "milestone": "0.2",
  "pure": false,
  "inputs": [],
  "outputs": [
    {
      "name": "then",
      "type": "Exec"
    }
  ],
  "fields": {
    "seconds": {
      "type": "number",
      "minimum": 0.01,
      "default": 1
    },
    "repeat": {
      "type": "boolean",
      "default": true
    },
    "name": {
      "type": "string",
      "default": "",
      "description": "Optional name, so Cancel Delay / Stop Timer can find this node (the node id is used when empty)"
    }
  },
  "as2Template": "templates/OnTimer.as2",
  "extra": {
    "entry": true,
    "timer": "seconds",
    "timerKey": "name",
    "timerRepeat": "repeat"
  }
}
