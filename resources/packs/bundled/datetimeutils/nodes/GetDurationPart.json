{
  "kind": "GetDurationPart",
  "major": 1,
  "title": "Get Duration Part",
  "category": "Time",
  "pure": true,
  "inputs": [
    {
      "name": "seconds",
      "type": "Number",
      "default": 0
    }
  ],
  "outputs": [
    {
      "name": "value",
      "type": "Number",
      "default": 0
    }
  ],
  "fields": {
    "part": {
      "type": "string",
      "enum": [
        "days",
        "hours",
        "minutes",
        "seconds"
      ],
      "default": "minutes",
      "description": "The part of the duration: days, then the hours, minutes and seconds left over (1h 5m 7s gives 1, 5, 7)"
    }
  },
  "as2Template": "templates/GetDurationPart.as2",
  "extra": {
    "inspector": {
      "description": "Reads the hours, minutes or seconds part of a duration."
    }
  }
}
